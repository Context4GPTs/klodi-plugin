{
  "name": "@4gpts/klodi",
  "version": "0.2.0",
  "description": "The marketplace where agents buy and sell stuff for you — the next generation of Facebook Marketplace, Craigslist, OfferUp, and Etsy. Your OpenClaw agent lists, searches, negotiates, and closes peer-to-peer deals; you approve the ones that matter.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Context4GPTs/klodi-plugin.git"
  },
  "homepage": "https://4gpts.com",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "klodi",
    "marketplace",
    "p2p",
    "agent",
    "4gpts",
    "negotiation",
    "deals"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "skill",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.4.1",
      "minGatewayVersion": ">=2026.4.15"
    },
    "build": {
      "openclawVersion": "2026.4.15",
      "pluginSdkVersion": "2026.4.15"
    },
    "install": {
      "npmSpec": "@4gpts/klodi",
      "localPath": "./",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.15"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "copy-skill": "node copy-skill.mjs",
    "build": "pnpm copy-skill && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "stamp-version": "node scripts/stamp-version.mjs",
    "tag": "node scripts/tag-version.mjs",
    "prepublish": "pnpm stamp-version && bash scripts/smoke-plugin-load.sh && pnpm tag",
    "pack:inspect": "pnpm build && node scripts/pack-with-bundles.mjs --pack-destination /tmp/klodi-pack && tar -tzf /tmp/klodi-pack/*.tgz | sort",
    "publish:clawhub:dry": "pnpm prepublish && clawhub package publish \"$PWD\" --dry-run --source-repo Context4GPTs/klodi-plugin --source-commit \"$(git rev-parse HEAD)\"",
    "publish:clawhub": "pnpm prepublish && clawhub package publish \"$PWD\" --tags latest --source-repo Context4GPTs/klodi-plugin --source-commit \"$(git rev-parse HEAD)\""
  },
  "dependencies": {
    "@klodi/nats-client": "workspace:*",
    "@klodi/tool-catalog": "workspace:*",
    "@nats-io/jetstream": "3.3.1",
    "@nats-io/nats-core": "3.3.1",
    "@nats-io/nkeys": "2.0.3",
    "@nats-io/nuid": "2.0.3",
    "@sinclair/typebox": "0.34.14",
    "gray-matter": "4.0.3",
    "tweetnacl": "1.0.3",
    "ws": "8.18.0"
  },
  "bundleDependencies": [
    "@klodi/nats-client",
    "@klodi/tool-catalog"
  ],
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/ws": "8.5.14",
    "typescript": "5.8.3",
    "vitest": "4.1.2"
  }
}
