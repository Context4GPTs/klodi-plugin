# Codex OAuth credential for Hermes (ChatGPT subscription auth, mode 0600).
# Bootstrap once via `hermes auth add openai-codex --type oauth --no-browser`
# inside a container with HERMES_HOME bind-mounted, then extract auth.json.
demo/.codex-auth.json

# Codex OAuth credential for OpenClaw (ChatGPT subscription auth, mode 0600).
# Bootstrap once via `openclaw models auth login --provider openai-codex`
# (interactive TTY required) inside a container with .openclaw bind-mounted,
# then extract agents/main/agent/auth-profiles.json.
demo/.openclaw-codex-auth.json

# Dev NATS JWT keys (generated by infra/nats/generate-dev-keys.sh)
infra/nats/dev-keys/
infra/nats/.nsc-dev/

# Prod NATS JWT keys (staged during rotation; Bitwarden is durable storage)
infra/nats/prod-keys/

