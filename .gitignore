# Claude Code harness (cc-setup, gitignored mode)
# klodi-plugin runs the harness locally only — the entire .claude/ tree,
# the cards/ substrate, BOARD.md, and INDEX.base stay out of git. See
# .claude/skills/repo-bootstrap/SKILL.md for the cheat sheet.
.claude/
.claude/worktrees/
.claude/worktree-description.txt
.claude/board-state.md
.claude/sync.log
.claude/scheduled_tasks.lock
.obsidian/
cards/
BOARD.md
CLAUDE.md
INDEX.base
.mcp.json

# Build-time skill copy — canonical source is klodi-plugin/skill/; each
# adapter's publish pipeline copies it into its own adapter root via
# `copy-skill.mjs`. Never commit the adapter-local copy. openclaw copies
# into a namespaced `klodi-skill/` so the published host skill slug can't
# collide with other plugins shipping a generic `skill/` folder.
klodi-plugin/adapters/*/skill/
klodi-plugin/adapters/openclaw/klodi-skill/

# Per-adapter publish staging tree (scripts/vendor.mjs target). Holds a
# self-contained snapshot of the publish-ready artefact with workspace
# @klodi/* deps inlined under dist/_vendor/. Recreated on every
# pnpm build:vendored — never commit.
adapters/*/.publish-stage/

# Internal docs — local-only, not shipped with the repo or any release
# artefact. Public-facing context lives in docs/decisions/ (ADRs),
# docs/specs/hosts/ (per-host adapter specs), SECURITY.md, and
# docs/THREAT_MODEL.md.
#
# knowledge/ and product/ are kanban-harness distillation surfaces (see
# .claude/skills/distillation/SKILL.md) — their content is repo-internal
# context that would leak implementation detail / unshipped product
# thinking if published.
docs/knowledge/
docs/product/
docs/plans/
docs/reports/

# E2E agent test artifacts (generated per run)
tests/e2e/homes/
tests/e2e/transcripts/
tests/e2e/.runs/
tests/e2e/.artifacts/
tests/e2e/.stage/
tests/e2e/.stage-hermes/

# Manual evaluation results (generated per session)
tests/eval/results/

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite logs files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
